# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<리소스이름>.openai.azure.com
AZURE_OPENAI_API_KEY=<API 키>
AZURE_OPENAI_DEPLOYMENT=<배포 이름 - Azure 포털/Foundry 의 Deployment name>
AZURE_OPENAI_API_VERSION=2024-10-21

# APIM 등 사내 게이트웨이를 쓰는 경우 (endpoint 대신 전체 base URL)
# AZURE_OPENAI_BASE_URL=https://apim.company.com/openai/deployments/<배포이름>
# APIM_SUBSCRIPTION_KEY=

